{
  "mcpServers": {
    "notebooklm": {
      "command": "/opt/node22/bin/notebooklm-mcp",
      "args": [],
      "env": {
        "BROWSER_CHANNEL": "chromium",
        "PLAYWRIGHT_BROWSERS_PATH": "/opt/pw-browsers",
